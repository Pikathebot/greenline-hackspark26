# Copy to backend/.env (gitignored) and adjust for this laptop.
# All vars are prefixed GREENLINE_ except GITHUB_TOKEN. See docs/03-ARCHITECTURE.md.

GREENLINE_MODEL_URL=http://127.0.0.1:8080
GREENLINE_EMBED_URL=http://127.0.0.1:8081
GREENLINE_MODEL=qwen3-8b
GREENLINE_MODELS_DIR=models
GREENLINE_SANDBOX_IMAGE=greenline-sandbox:latest
GREENLINE_DB_PATH=greenline.db
GREENLINE_FIXTURE_REPO=fixtures/ledger-core
GREENLINE_DEMO_RUNS_DIR=demo_runs

GREENLINE_MAX_MODEL_CALLS=16
GREENLINE_MAX_TOOL_CALLS=16
GREENLINE_MAX_ELAPSED_MS=180000

GREENLINE_TIGHT_MODEL_CALLS=4
GREENLINE_TIGHT_TOOL_CALLS=3
GREENLINE_TIGHT_ELAPSED_MS=60000

GREENLINE_RERUN_CONCURRENCY=1
GREENLINE_DRY_RUN=true
# Demo playback speed multiplier (1.0 = original recorded pace). Not part of
# the contract -- a dev/test knob only.
GREENLINE_DEMO_SPEED=1.0

GREENLINE_CORS_ORIGINS=http://localhost:5173

# Only when DRY_RUN=false (stretch):
GITHUB_TOKEN=

# B18 (docs/plans/B18-github-ci.md): watch a real GitHub test repo for red Actions runs and open
# real draft PRs. Needs GITHUB_TOKEN (fine-grained PAT for that repo only) and GREENLINE_DRY_RUN=false.
# GREENLINE_GITHUB_REPO=Pikathebot/ledger-core
# GREENLINE_GITHUB_POLL_S=10

# Optional: override the llama-server.exe path (scripts/llama-server.ps1 / llama-embed.ps1)
# LLAMA_SERVER=C:\path\to\llama-server.exe
